FROM python:3.12-slim

WORKDIR /code

# Устанавливаем системные зависимости для LightGBM и XGBoost
RUN apt-get update && apt-get install -y \
    build-essential \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

COPY API/requirements.txt ./API/
RUN pip install --no-cache-dir -r ./API/requirements.txt

COPY API/app ./API/app/

EXPOSE $PORT

# Увеличиваем таймаут для долгих операций и отключаем access логи
CMD sh -c "uvicorn API.app.main:app --host 0.0.0.0 --port $PORT --timeout-keep-alive 600 --log-level warning --no-access-log"